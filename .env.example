# ---- server ----
NODE_ENV=development
PORT=4000
# Comma-separated list of origins allowed to call the API (website + dashboard)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- database ----
# Prisma Postgres connection string (roles/statuses are validated strings, see src/contracts).
DATABASE_URL="postgres://user:password@db.prisma.io:5432/postgres?sslmode=require"

# ---- mail (pluggable — see src/lib/mail) ----
# console = log emails to stdout (default for local dev)
# smtp    = real delivery; for Gmail create an App Password (requires 2FA) and use smtp.gmail.com:465
MAIL_PROVIDER=console
MAIL_FROM="Simplified Startup <hello@simplifiedstartup.com>"
# Where new-lead / new-application notifications are sent
NOTIFY_EMAIL=hello@simplifiedstartup.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# ---- dashboard (used in invite / password-reset links) ----
DASHBOARD_URL=http://localhost:5173

# ---- storage (pluggable — see src/lib/storage) ----
# local = files under UPLOAD_DIR; blob = Vercel Blob (durable, used in production).
# Unset, blob is picked automatically whenever BLOB_READ_WRITE_TOKEN is present.
# STORAGE_PROVIDER=blob
# Vercel injects this on deploys; for local dev copy it from the project's env vars.
# BLOB_READ_WRITE_TOKEN=
# Local-disk provider root for uploaded CVs
UPLOAD_DIR=./uploads

# ---- publish to website ----
# Optional: POSTed when someone clicks "Publish to website" in the dashboard
# (a Vercel/Netlify deploy hook URL). Unset = publish just records the click.
# WEBSITE_DEPLOY_HOOK_URL=

# ---- bootstrap admin (created by `npm run db:seed`) ----
SEED_ADMIN_EMAIL=himanshu@ecommercecollections.com
SEED_ADMIN_NAME=Himanshu
SEED_ADMIN_PASSWORD=change-me-now
